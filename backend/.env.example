# 环境变量配置文件示例

# JWT配置
JWT_SECRET=replace_with_a_long_random_secret

# CORS配置 (JSON数组)
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]

# LLM提供商: openai / deepseek / gemini / qwen / zhipu
LLM_PROVIDER=deepseek

# DeepSeek配置 (推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini配置
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLE_GROUNDING=true

# 通义千问配置
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENABLE_SEARCH=true

# 智谱配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-air
ZHIPU_ENABLE_WEB_SEARCH=true

# Tavily联网搜索工具配置
TAVILY_API_KEY=
TAVILY_ENABLED=false
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=news
TAVILY_TIME_RANGE=week
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=12

# 数据库 (默认SQLite)
DATABASE_URL=sqlite+aiosqlite:///./etf.db
